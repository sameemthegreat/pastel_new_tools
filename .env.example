# Copy to .env.local and adjust per environment.

# Base URL of the Pastel backend (marketplace_new_backend), including the /api/v1 prefix.
# The backend must allow this app's origin in its CORS config (localhost:3000 is allowed by default)
# because auth relies on the cross-origin httpOnly `pa_rt` refresh cookie.
NEXT_PUBLIC_API_URL=https://api-v1-new.mypastel.com/api/v1

# Server-only base URL the /api/admin proxy forwards to. Optional — falls back to
# NEXT_PUBLIC_API_URL. Set it when the server should reach the backend over a private network.
# BACKEND_API_URL=http://localhost:3500/api/v1

# Server-only (no NEXT_PUBLIC prefix — it must never reach the browser bundle).
# Must equal the backend's ADMIN_SECRET; the /api/admin proxy attaches it as X-Operator-Secret.
#
# This is a SECOND FACTOR, not an authorisation. The backend authorises each admin request on the
# signed-in operator's own active AdminMembership, so holding this secret grants nothing by itself
# and revoking one person's access is a membership change — no rotation, no redeploy.
OPERATOR_SECRET=change-me

# Server-only base URL of the migration control-plane (FastAPI, data-migration/app).
# The /api/migration proxy forwards here, attaching OPERATOR_SECRET server-side. On the
# droplet this is the private http://migration-api:8080 (shared docker network); remotely
# it's the Nginx-exposed subdomain. The migration service reuses the SAME JWT_SECRET and
# ADMIN_SECRET as the backend, so the operator's session authorises it too.
MIGRATION_API_URL=http://localhost:8080
MIGRATION_API_URL=https://migration-v1-new.droplet.mypastel.com

# Staging migration control-plane (the "Target: Staging backend" option on /migration). It loads
# into the STAGING backend database (api-staging-new). This console's operator and JWT live in the
# dev backend, so the staging service cannot verify them; this leg authenticates with the
# cross-backend bridge instead: the proxy verifies the caller is a superAdmin on the dev backend,
# then attaches X-Cross-Backend-Secret. Must equal MIGRATION_CROSS_BACKEND_SECRET on the staging
# migration API (which also needs MIGRATION_CROSS_BACKEND_ENABLED=true). Server-only. Leave both
# unset → the staging target shows "not configured"; the dev target keeps working.
MIGRATION_STAGING_API_URL=https://staging.data-migration.mypastel.com
MIGRATION_STAGING_CROSS_BACKEND_SECRET=change-me


# ── Dual-run cross-backend aggregation (Users + Seller requests) ──────────────
# During migration there are TWO backends: the primary one above (NEXT_PUBLIC_API_URL) and a
# sibling "droplet" backend. Setting the two vars below turns it on — the Users + Seller-request
# lists then show BOTH backends' rows (each tagged with a Source chip) and route approve/ban/etc
# back to the row's own backend. Enablement is SERVER-ONLY (no build-time flag, no rebuild needed):
# the /api/admin proxy targets DROPLET_API_URL for `?__backend=droplet` calls and authorises with
# the shared secret. Leave DROPLET_API_URL unset → single-backend (the fan-out call 501s and is
# ignored). The droplet backend must run with CROSS_BACKEND_ADMIN_ENABLED=true and a matching
# CROSS_BACKEND_SECRET; the console's operator lives in the PRIMARY DB, so the droplet accepts this
# secret header instead of a bearer.
DROPLET_API_URL=https://api-v1-new.droplet.mypastel.com/api/v1
DROPLET_CROSS_BACKEND_SECRET=change-me

# ── API-gateway cutover switch (the "Backend switch" card on /migration) ───────
# The gateway (api-gateway repo) is the switch that repoints every installed app build between
# Sharetribe and the v2 wrapper. The /api/gateway proxy calls it server-side, attaching the token
# below, but ONLY after verifying the caller is a superAdmin against the backend. Leave GATEWAY_*
# unset → the card shows a clear "missing GATEWAY_API_URL" error and nothing can be switched.
GATEWAY_API_URL=https://api-gateway.mypastel.com

# Server-only (no NEXT_PUBLIC prefix — must never reach the browser bundle). Must equal the
# gateway's own GATEWAY_ADMIN_TOKEN; the /api/gateway proxy attaches it as X-Gateway-Admin-Token.
GATEWAY_ADMIN_TOKEN=change-me

# Staging gateway (staging.api-gateway.mypastel.com) — the second "Backend switch" card. It flips the
# staging / preview app builds between the DEV Sharetribe marketplace and the staging v2 wrapper.
# Same rules as above: server-only, token must equal that gateway's own GATEWAY_ADMIN_TOKEN. Leave
# unset → only the staging card shows "not configured"; the production switch keeps working.
GATEWAY_STAGING_API_URL=https://staging.api-gateway.mypastel.com
GATEWAY_STAGING_ADMIN_TOKEN=change-me
