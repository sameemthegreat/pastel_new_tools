# Copy to .env.local and adjust per environment.

# Base URL of the Pastel backend (marketplace_new_backend), including the /api/v1 prefix.
# The backend must allow this app's origin in its CORS config (localhost:3000 is allowed by default)
# because auth relies on the cross-origin httpOnly `pa_rt` refresh cookie.
NEXT_PUBLIC_API_URL=http://localhost:3500/api/v1
